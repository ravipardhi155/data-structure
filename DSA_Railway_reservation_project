#include <iostream>
#include <string>
#include <cstdlib>
#include <limits>
using namespace std;

int TOTAL_SEATS = 30;
struct Passenger {
    int seatNo;
    string name;
    int age;
    char gender;
    Passenger* next;
};

Passenger* start = nullptr;
int* seats = nullptr;

void bookTicket() {
    int seat = -1;

    for (int i = 0; i < TOTAL_SEATS; i++) {
        if (seats[i] == 0) {
            seat = i;
            break;
        }
    }
    if (seat == -1) {
        cout << "\nSorry! No seats available.\n";
        return;
    }
    Passenger* p = new Passenger;

    p->seatNo = seat + 1;

    cout << "Enter Name: ";
    getline(cin, p->name);

    cout << "Enter Age: ";
    cin >> p->age;

    cout << "Enter Gender (M/F/O): ";
    cin >> p->gender;

    cin.ignore(numeric_limits<streamsize>::max(), '\n');

    p->next =start;
    start = p;

    seats[seat] = 1;

    cout << "\nTicket booked successfully!\n";
    cout << "Seat Number: " << seat + 1 << "\n";
}
void cancelTicket() {
    int seatNo;

    cout << "Enter Seat Number to Cancel: ";
    cin >> seatNo;
    cin.ignore(numeric_limits<streamsize>::max(), '\n');

    if (seatNo < 1 || seatNo > TOTAL_SEATS) {
        cout << "Invalid seat number!\n";
        return;
    }
    Passenger* current = start;
    Passenger* previous = nullptr;

    while (current != nullptr &&
           current->seatNo != seatNo) {
        previous = current;
        current = current->next;
    }
    if (current == nullptr) {
        cout << "Ticket not found!\n";
        return;
    }
    if (previous == nullptr) {
        start = current->next;
    } else {
        previous->next = current->next;
    }
    seats[seatNo - 1] = 0;
    delete current;

    cout << "Ticket cancelled successfully!\n";
}
void viewTrainStatus() {
    cout << "\n Train Seat Status \n";

    for (int i = 0; i < TOTAL_SEATS; i++) {
        cout << "Seat " << i + 1 << ": ";
        if (seats[i] == 1) {
            cout << "Booked\n";
        } else {
            cout << "Available\n";
        }
    }
}
void viewPassengerList() {
    Passenger* current = start;

    if (current == nullptr) {
        cout << "\nNo passengers booked yet.\n";
        return;
    }

    cout << "\n Passenger List  \n";
    while (current != nullptr) {
        cout << "Seat No: " << current->seatNo
             << " | Name: " << current->name
             << " | Age: " << current->age
             << " | Gender: " << current->gender
             << "\n";

        current = current->next;
    }
}
void cleanup() {
    Passenger* current = start;

    while (current != nullptr) {
        Passenger* temp = current;
        current = current->next;
        delete temp;
    }

    start = nullptr;
    free(seats);
    seats = nullptr;
}
int main() {
    seats = (int*)malloc(TOTAL_SEATS * sizeof(int));
    if (seats == nullptr) {
        cout << "Memory allocation failed!\n";
        return 1;
    }
    for (int i = 0; i < TOTAL_SEATS; i++) {
        seats[i] = 0;
    }
    int choice;
    do {
        cout << "\n  RAILWAY RESERVATION SYSTEM   \n";
        cout << "1. Book Ticket\n";
        cout << "2. Cancel Ticket\n";
        cout << "3. View Train Status\n";
        cout << "4. View Passenger List\n";
        cout << "5. Exit\n";
        cout << "Enter your choice: ";

        if (!(cin >> choice)) {
            cout << "Invalid input!\n";
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            continue;
        }
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        switch (choice) {
            case 1:
                bookTicket();
                break;
            case 2:
                cancelTicket();
                break;
            case 3:
                viewTrainStatus();
                break;
            case 4:
                viewPassengerList();
                break;
            case 5:
                cleanup();
                cout << "Thank you for using the system\n";
                break;
            default:
                cout << "Invalid choice! Try again.\n";
        }
    } while (choice != 5);
    return 0;
}
